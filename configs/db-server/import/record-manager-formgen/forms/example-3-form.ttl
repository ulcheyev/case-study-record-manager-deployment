leaves:annotation-oak-2 a form-media:annotation ;
    form-media-ann:has-annotation-type "text" ;
    form-media-ann:has-geometry-points "0.026650641924134907,0.03405243515232216" ;
    form-media-ann:has-color "#0066f8" ;
    form-media-ann:has-stroke-width 0.00425531914893617 ;
