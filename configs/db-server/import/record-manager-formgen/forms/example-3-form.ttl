@prefix form-media: <http://onto.fel.cvut.cz/ontologies/form/media/> .

leaves:form-root a doc:question ;
    a form:form-template ;
    dcterms:hasVersion <https://example.org/sfc-leaves-learning/form-root/0.0.1> ;
    rdfs:label "Tree Identification by Leaf Shape - Learning" ;
    rdfs:comment "Learning form: identify 4 tree species from leaf images, with annotations and correct-answer hints." ;
    doc:has_related_question leaves:q-birch ,
        leaves:q-maple ,
        leaves:q-oak ,
        leaves:q-linden ;
    form-lt:has-layout-class "form" ;
    form:has-question-origin leaves:form-root-qo .

# === Question 1 — Oak ===

leaves:q-oak a doc:question ;
    rdfs:label "Which tree does this leaf belong to?" ;
    form:has-question-origin leaves:q-oak-qo ;
    form-lt:has-layout-class "select" ;
    form:has-possible-value leaves:tree-oak ,
        leaves:tree-hawthorn ,
        leaves:tree-hornbeam ,
        leaves:tree-elm ;
    form:has-correct-answer-value leaves:tree-oak ;
    form:has-media-content leaves:asset-oak .

leaves:asset-oak a form-media:asset ;
    form-media:has-source "https://images.pexels.com/photos/18293920/pexels-photo-18293920/free-photo-of-close-up-of-a-green-oak-leaf.jpeg" ;
    form-media:has-annotation leaves:annotation-oak-1 ,
                              leaves:annotation-oak-2 .

